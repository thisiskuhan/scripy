{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scripy:screenplay:3",
  "title": "Scripy Screenplay Version 3",
  "type": "object",
  "required": [
    "version",
    "id",
    "title",
    "author",
    "draft",
    "logline",
    "createdAt",
    "updatedAt",
    "blocks",
    "notes",
    "annotations",
    "paperSize",
    "titleArtwork"
  ],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 3 },
    "paperSize": { "enum": ["letter", "a4"] },
    "titleArtwork": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "dataUrl", "width", "height"],
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S" },
            "dataUrl": {
              "type": "string",
              "maxLength": 2000022,
              "pattern": "^data:image/png;base64,[A-Za-z0-9+/]+={0,2}$"
            },
            "width": { "type": "integer", "minimum": 1, "maximum": 1600 },
            "height": { "type": "integer", "minimum": 1, "maximum": 1600 }
          }
        }
      ]
    },
    "id": { "$ref": "#/$defs/identifier" },
    "title": { "type": "string", "minLength": 1, "maxLength": 300, "pattern": "\\S" },
    "author": { "type": "string", "maxLength": 300 },
    "draft": { "type": "string", "maxLength": 100 },
    "logline": { "type": "string", "maxLength": 5000 },
    "createdAt": { "type": "string", "format": "date-time", "maxLength": 50 },
    "updatedAt": { "type": "string", "format": "date-time", "maxLength": 50 },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "text"],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "kind": {
            "enum": ["scene", "action", "character", "dialogue", "parenthetical", "transition", "shot"]
          },
          "text": { "type": "string", "maxLength": 100000 }
        }
      }
    },
    "annotations": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "quote",
          "text",
          "departments",
          "tags",
          "resolved",
          "ranges",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "quote": { "type": "string", "minLength": 1, "maxLength": 20000, "pattern": "\\S" },
          "text": { "type": "string", "minLength": 1, "maxLength": 20000, "pattern": "\\S" },
          "departments": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 30,
            "items": { "type": "string", "minLength": 1, "maxLength": 40, "pattern": "\\S" }
          },
          "tags": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 12,
            "items": { "type": "string", "minLength": 1, "maxLength": 40, "pattern": "\\S" }
          },
          "resolved": { "type": "boolean" },
          "createdAt": { "type": "string", "format": "date-time", "maxLength": 50 },
          "updatedAt": { "type": "string", "format": "date-time", "maxLength": 50 },
          "ranges": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["blockId", "from", "to"],
              "properties": {
                "blockId": { "$ref": "#/$defs/identifier" },
                "from": { "type": "integer", "minimum": 0, "maximum": 100000 },
                "to": { "type": "integer", "minimum": 1, "maximum": 100000 }
              }
            }
          }
        }
      }
    },
    "notes": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": { "type": "string", "maxLength": 20000 }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[A-Za-z0-9_-]+$" }
  }
}
